<Window x:Class="KDS.PRE.Vistas.VistaTicket"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KDS — Vista previa del ticket"
        Width="440" Height="720"
        MinWidth="380" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="#101010">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="VISTA PREVIA DEL TICKET" Foreground="#F5A623"
                       FontSize="17" FontWeight="Bold"/>
            <TextBlock Text="Resumen de la comanda actual" Foreground="#AAAAAA"
                       FontSize="11" Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Background="White" Padding="22">
                <StackPanel x:Name="ContenidoTicket">
                    <TextBlock Text="KDS" Foreground="Black" FontSize="30"
                               FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="RESUMEN DEL PEDIDO" Foreground="#444444"
                               FontSize="12" TextAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock x:Name="TextoFecha" Foreground="#666666"
                               FontSize="10" TextAlignment="Center" Margin="0,8,0,18"/>

                    <Border Height="1" Background="#CCCCCC"/>

                    <Grid Margin="0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TextoNumeroTicket" Text="Pedido: #001"
                                   Foreground="Black" FontSize="12"/>
                        <TextBlock x:Name="TextoMesaTicket" Grid.Column="1" Text="Mesa: 01"
                                   Foreground="Black" FontSize="12"/>
                    </Grid>

                    <TextBlock x:Name="TextoMeseroTicket" Foreground="#444444"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <Border Height="1" Background="#CCCCCC"/>

                    <ItemsControl x:Name="ProductosTicket" Margin="0,0,0,18">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Foreground="Black" FontSize="12"
                                                   FontWeight="SemiBold" TextWrapping="Wrap">
                                            <Run Text="{Binding Cantidad, Mode=OneWay}"/>
                                            <Run Text=" × "/>
                                            <Run Text="{Binding Nombre, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding PrecioUnitarioTexto}"
                                                   Foreground="#666666" FontSize="10" Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding Notas, Mode=OneWay}"
                                                   Foreground="#555555" FontSize="10"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SubtotalTexto}"
                                               Foreground="Black" FontSize="12" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="#CCCCCC"/>

                    <Grid Margin="0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="TOTAL" Foreground="Black"
                                   FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="TotalTicket" Grid.Column="1"
                                   Foreground="Black" FontSize="18" FontWeight="Bold"/>
                    </Grid>

                    <TextBlock x:Name="CantidadTicket" Foreground="#666666"
                               FontSize="11" Margin="0,0,0,16"/>

                    <StackPanel x:Name="PanelObservaciones" Margin="0,0,0,16">
                        <TextBlock Text="OBSERVACIONES" Foreground="Black"
                                   FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="ObservacionesTicket" Foreground="#444444"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>

                    <Border Height="1" Background="#CCCCCC"/>

                    <TextBlock Text="¡Gracias por tu pedido!" Foreground="Black"
                               FontSize="13" FontWeight="SemiBold"
                               TextAlignment="Center" Margin="0,20,0,0"/>
                    <TextBlock Text="Este resumen no es una factura de venta."
                               Foreground="#666666" FontSize="10" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Button Grid.Row="2" Content="IMPRIMIR TICKET" Click="BtnImprimir_Click"
                Height="44" Margin="0,16,0,0" Foreground="#111111"
                FontSize="12" FontWeight="Bold" Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="BordeImprimir" Background="#F5A623"
                            BorderBrush="#F5A623" BorderThickness="1" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BordeImprimir" Property="Background" Value="#FFB940"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BordeImprimir" Property="Background" Value="#D98A10"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="BordeImprimir" Property="BorderBrush" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>