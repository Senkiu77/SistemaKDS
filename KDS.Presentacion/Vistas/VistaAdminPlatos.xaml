<Window x:Class="KDS.PRE.Vistas.VistaAdminPlatos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KDS — Administrar platos" Icon="/Assets/logo-kdss.png"
        Width="1040" Height="700" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#080808">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="TextoDueno" Text="DUEÑO" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold"/>
            <TextBlock Text="Platos del menú" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/>
            <TextBlock Text="Los cambios se ven al instante en el punto de venta y en el menú web de las mesas."
                       Foreground="#888888" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Background="#101010" BorderBrush="#333333" BorderThickness="1" CornerRadius="10" Padding="10">
                <DataGrid x:Name="GrillaPlatos" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#262626"
                          Background="#101010" RowBackground="#151515" AlternatingRowBackground="#1A1A1A"
                          Foreground="#EEEEEE" BorderThickness="0" FontSize="13" RowHeight="34"
                          SelectionChanged="GrillaPlatos_SelectionChanged">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Background" Value="#202020"/>
                            <Setter Property="Foreground" Value="#F5A623"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderBrush" Value="#333333"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#3A2B16"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdPlato}" Width="60"/>
                        <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding Categoria}" Width="130"/>
                        <DataGridTextColumn Header="PRECIO" Binding="{Binding Precio, StringFormat='$ {0:N0}', ConverterCulture=es-CO}" Width="110"/>
                        <DataGridTemplateColumn Header="ESTADO" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Text" Value="● Activo"/>
                                                <Setter Property="Foreground" Value="#39D98A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                                        <Setter Property="Text" Value="● Agotado"/>
                                                        <Setter Property="Foreground" Value="#FF6464"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Background="#101010" BorderBrush="#333333" BorderThickness="1"
                    CornerRadius="10" Padding="18">
                <StackPanel>
                    <TextBlock x:Name="TituloFormulario" Text="NUEVO PLATO" Foreground="White"
                               FontSize="15" FontWeight="Bold"/>

                    <TextBlock Text="NOMBRE" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtNombre" Style="{StaticResource Campo}" MaxLength="100"/>

                    <TextBlock Text="PRECIO (COP)" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtPrecio" Style="{StaticResource Campo}" MaxLength="12"
                             PreviewTextInput="TxtPrecio_PreviewTextInput"/>

                    <TextBlock Text="CATEGORÍA (OBLIGATORIA)" Style="{StaticResource Etiqueta}"/>
                    <UniformGrid Columns="3" Margin="0,0,-6,0">
                        <RadioButton x:Name="OpcionComida" Content="Comida" Tag="Comida"
                                     GroupName="CategoriaPlato" Style="{StaticResource Opcion}"/>
                        <RadioButton x:Name="OpcionBebida" Content="Bebida" Tag="Bebida"
                                     GroupName="CategoriaPlato" Style="{StaticResource Opcion}"/>
                        <RadioButton x:Name="OpcionAcompanamiento" Content="Acompañamiento" Tag="Acompañamiento"
                                     GroupName="CategoriaPlato" Style="{StaticResource Opcion}"/>
                    </UniformGrid>

                    <CheckBox x:Name="ChkActivo" Content="Disponible para la venta" IsChecked="True"
                              Foreground="#DDDDDD" FontSize="12" Margin="0,16,0,0"/>

                    <Button x:Name="BtnAgregar" Content="AGREGAR PLATO" Click="BtnAgregar_Click"
                            Style="{StaticResource Boton}" Background="#F5A623" BorderBrush="#F5A623"
                            Foreground="#111111" Margin="0,22,0,0"/>
                    <Button x:Name="BtnModificar" Content="GUARDAR CAMBIOS" Click="BtnModificar_Click"
                            Style="{StaticResource Boton}" Margin="0,10,0,0" IsEnabled="False"/>
                    <Button x:Name="BtnEliminar" Content="ELIMINAR" Click="BtnEliminar_Click"
                            Style="{StaticResource Boton}" Foreground="#FF6464" Margin="0,10,0,0" IsEnabled="False"/>
                    <Button x:Name="BtnLimpiar" Content="LIMPIAR" Click="BtnLimpiar_Click"
                            Style="{StaticResource Boton}" Margin="0,10,0,0"/>
                    <Button x:Name="BtnCambiarClave" Content="CAMBIAR MI CLAVE" Click="BtnCambiarClave_Click"
                            Style="{StaticResource Boton}" Margin="0,10,0,0"/>

                    <TextBlock x:Name="TextoEstado" Foreground="#999999" FontSize="11"
                               TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
