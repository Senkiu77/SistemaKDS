<Window x:Class="KDS.PRE.Vistas.VistaAccesoDueno"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KDS — Acceso del dueño" Icon="/Assets/logo-kdss.png"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#080808">

    <StackPanel Margin="24">
        <TextBlock Text="SOLO DUEÑOS" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold"/>
        <TextBlock x:Name="TextoTitulo" Text="Entrar a administrar el menú" Foreground="White"
                   FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="TextoAyuda" Foreground="#888888" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>

        <StackPanel x:Name="PanelDueno">
            <TextBlock Text="DUEÑO" Style="{StaticResource Etiqueta}"/>
            <ComboBox x:Name="CmbDueno" DisplayMemberPath="Nombre" Height="34" FontSize="13"
                      VerticalContentAlignment="Center" SelectionChanged="CmbDueno_SelectionChanged"/>
        </StackPanel>

        <StackPanel x:Name="PanelClaveActual">
            <TextBlock Text="CLAVE ACTUAL" Style="{StaticResource Etiqueta}"/>
            <PasswordBox x:Name="TxtClaveActual" Style="{StaticResource CampoClave}" MaxLength="64"/>
        </StackPanel>

        <TextBlock x:Name="EtiquetaClave" Text="CLAVE" Style="{StaticResource Etiqueta}"/>
        <PasswordBox x:Name="TxtClave" Style="{StaticResource CampoClave}" MaxLength="64"/>

        <StackPanel x:Name="PanelConfirmar">
            <TextBlock Text="REPITE LA CLAVE" Style="{StaticResource Etiqueta}"/>
            <PasswordBox x:Name="TxtConfirmar" Style="{StaticResource CampoClave}" MaxLength="64"/>
        </StackPanel>

        <TextBlock x:Name="TextoError" Foreground="#FF6464" FontSize="12" Margin="0,12,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnCancelar" Content="CANCELAR" IsCancel="True" Style="{StaticResource Boton}"/>
            <Button x:Name="BtnEntrar" Grid.Column="2" Content="ENTRAR" IsDefault="True" Click="BtnEntrar_Click"
                    Style="{StaticResource Boton}" Background="#F5A623" BorderBrush="#F5A623" Foreground="#111111"/>
        </Grid>
    </StackPanel>
</Window>
